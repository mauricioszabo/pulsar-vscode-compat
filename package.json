{
  "name": "pulsar-vscode-compat",
  "version": "2026.7.25-18",
  "description": "VSCode API compatibility layer for Pulsar",
  "repository": "https://github.com/mauricioszabo/pulsar-vscode-compat",
  "main": "./lib/main.js",
  "engines": {
    "pulsar": ">=1.0.0 <2.0.0"
  },
  "configSchema": {
    "showInlayHints": {
      "type": "boolean",
      "default": true,
      "title": "Show Inlay Hints",
      "description": "Display inlay hints (e.g. inferred types) as end-of-line annotations, with a detailed callout on the cursor line."
    }
  },
  "styleSheets": [
    "extension-browser.less",
    "inlay-hints.less"
  ],
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    },
    "linter-indie": {
      "versions": {
        "2.0.0": "consumeLinterIndie"
      }
    },
    "autocomplete.watchEditor": {
      "versions": {
        "1.0.0": "consumeWatchEditor"
      }
    }
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "5.1.0": "provideAutocomplete"
      }
    },
    "symbol.provider": {
      "versions": {
        "1.0.0": "provideSymbols"
      }
    },
    "hover": {
      "versions": {
        "0.1.0": "provideHover"
      }
    },
    "outline-view": {
      "versions": {
        "0.1.0": "provideOutlines"
      }
    }
  }
}
